# ─────────────────────────────────────────────────────────────────────────────
# SyncFit Environment Variables (.env.example)
# Copy this file to .env.local and replace with your local development credentials:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MongoDB Database Connection
# Replace with your MongoDB Atlas or local MongoDB connection string:
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/syncfit?retryWrites=true&w=majority"

# NextAuth Configuration
# Base canonical URL for NextAuth authentication handlers:
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Encryption Secret
# Generate a secure 32-character key using: `openssl rand -base64 32`
NEXTAUTH_SECRET="your_nextauth_secret_key_change_in_production"
